# Gravequit Backend Environment Variables
# Copy this file to .env and replace the values with your actual keys.
# DO NOT COMMIT YOUR REAL .env FILE TO GIT!

# Postgres Database connection string (e.g., from Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/gravequit"

# Groq API Key for the LangGraph AI Pipeline (get from console.groq.com)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Secret key used to protect the /admin/retrain endpoint (Dev B / Dev C)
ADMIN_API_KEY="your_super_secret_admin_key"

# Google OAuth Client ID for "Continue with Google" sign-in
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Secret key used for signing JWT auth tokens
JWT_SECRET_KEY="your_super_secret_jwt_key_here"

# Comma-separated list of allowed frontend origins for CORS (Security Checklist #14)
# Default (dev): http://localhost:5173,http://localhost:5174,http://localhost:3000
# Production example: https://gravequit.vercel.app
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:3000"

# Email credentials for sending 6-digit verification codes
EMAIL_SENDER="your email"
EMAIL_PASSWORD="your-16-digit-app-password"
